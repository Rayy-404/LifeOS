NODE_ENV=development
PORT=3000

DATABASE_URL="postgresql://lifeos:change-me@localhost:5432/lifeos?schema=public"

JWT_ACCESS_SECRET="replace-with-a-long-random-secret"
JWT_ACCESS_TTL="15m"

# Simpan hash token refresh, bukan token mentah.
REFRESH_TOKEN_TTL_DAYS=30

# Daftar origin yang boleh mengakses API (comma separated).
# WAJIB diisi di production, contoh: "https://app.lifeos.id,https://lifeos.id"
CORS_ORIGIN="http://localhost:3000,http://localhost:8080"

# Aktifkan Swagger /api/docs (default: true di luar production).
# SWAGGER_ENABLED="false"

# Nilai proxy tepercaya bila API dijalankan di belakang reverse proxy
# (mis. "1" untuk satu hop). Biarkan kosong bila diakses langsung.
# TRUST_PROXY="1"

# Rate limit (per IP). Naikkan THROTTLE_LIMIT bila API dipakai di belakang
# proxy yang menyatukan banyak pengguna (default 60 request / menit).
# THROTTLE_LIMIT="60"
# THROTTLE_TTL_MS="60000"
# AUTH_THROTTLE_LIMIT="10"
# AUTH_THROTTLE_TTL_MS="60000"
