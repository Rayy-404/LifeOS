# ============================================================================
# LifeOS production environment (template)
# Salin menjadi backend/.env.production lalu isi semua nilai CHANGE_ME.
# File .env.production TIDAK boleh di-commit.
# ============================================================================

NODE_ENV=production
PORT=3000

# PostgreSQL service (dibaca oleh container postgres di docker-compose.prod.yml).
POSTGRES_DB=lifeos
POSTGRES_USER=lifeos
POSTGRES_PASSWORD="CHANGE_ME_DB_PASSWORD_ALPHANUMERIC"

# Host `postgres` adalah nama service di docker-compose.prod.yml.
# Password harus sama dengan POSTGRES_PASSWORD di atas.
DATABASE_URL="postgresql://lifeos:CHANGE_ME_DB_PASSWORD_ALPHANUMERIC@postgres:5432/lifeos?schema=public"

# Wajib. Buat dengan: openssl rand -hex 48
JWT_ACCESS_SECRET="CHANGE_ME_RANDOM_64_BYTE_HEX"
JWT_ACCESS_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=30

# Wajib di production. Untuk aplikasi Android native ini tidak dipakai, tetapi
# tetap harus diisi bila ada web/admin yang memanggil API.
CORS_ORIGIN="https://app.lifeos.id"

# Jangan aktifkan Swagger di production.
SWAGGER_ENABLED="false"

# Set "1" bila API berada di belakang satu reverse proxy (nginx/Caddy/Traefik)
# agar rate limit memakai IP klien yang benar.
TRUST_PROXY="1"

# Rate limit per IP. Turunkan bila API diekspos langsung ke publik.
THROTTLE_LIMIT="60"
THROTTLE_TTL_MS="60000"
AUTH_THROTTLE_LIMIT="10"
AUTH_THROTTLE_TTL_MS="60000"
